# Rendered by the Jenkins pipeline: __DOMAIN__ and __PORT__ are substituted,
# then certbot rewrites this file in place to add the TLS listener.
server {

    server_name __DOMAIN__;

    gzip              on;
    gzip_comp_level   2;
    gzip_min_length   1024;
    gzip_vary         on;
    gzip_proxied      expired no-cache no-store private auth;
    gzip_types        application/x-javascript application/javascript application/xml application/json text/xml text/css text/plain;

    # Statement/CSV imports post multi-megabyte bodies (server actions allow 25mb)
    # and PDF text extraction can run for a while, so the timeouts are generous
    # relative to a plain content site.
    client_body_timeout 60;
    client_header_timeout 20;
    send_timeout 60;
    proxy_read_timeout 300;
    proxy_send_timeout 300;
    reset_timedout_connection on;
    server_tokens off;
    client_max_body_size 100m;
    # Sign-in responses set three Cognito JWT cookies (~4-5 KB of headers). The
    # default 4k proxy_buffer_size can't hold them and nginx answers 502
    # "upstream sent too big header". proxy_buffering off does not bypass this
    # limit — it still governs the header read.
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    proxy_buffering off;
    chunked_transfer_encoding on;
    proxy_cache off;

    location / {
        expires off;
        proxy_pass       http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 80;

}
