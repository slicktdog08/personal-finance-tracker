{
  "name": "billingapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:init": "tsx scripts/init-db.ts && tsx scripts/apply-sql.ts --pending",
    "seed": "tsx scripts/seed-history.ts",
    "sync": "tsx --require ./tests/stubs.cjs scripts/bank-sync.ts",
    "test": "node --require ./tests/env-test.cjs --require ./tests/stubs.cjs --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --require ./tests/env-test.cjs --require ./tests/stubs-session.cjs --import tsx --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:all": "npm run test && npm run test:e2e",
    "db:test:up": "./scripts/test-db.sh up",
    "db:test:down": "./scripts/test-db.sh down",
    "db:test:reset": "./scripts/test-db.sh reset",
    "db:test:schema": "./scripts/dump-test-schema.sh",
    "purge:e2e": "tsx scripts/purge-e2e-residue.ts",
    "check:private": "./scripts/check-private.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1117.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "aws-jwt-verify": "^5.2.1",
    "drizzle-orm": "^0.45.2",
    "mcp-handler": "^2.1.1",
    "mysql2": "^3.24.5",
    "next": "16.2.9",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
