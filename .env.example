# Copy to .env.local and fill in the password.
# The database name "personal-billing" contains a hyphen — that's fine inside a URL.

# Runtime connection used by the Next.js app (needs SELECT/INSERT/UPDATE/DELETE).
DATABASE_URL="mysql://USER:PASSWORD@DB_HOST:3306/personal-billing"

# Connection used only by drizzle-kit for migrations (needs CREATE/ALTER).
# If your runtime user already has DDL rights, you can omit this and reuse DATABASE_URL.
DATABASE_MIGRATION_URL="mysql://ADMIN:PASSWORD@DB_HOST:3306/personal-billing"

# --- Deployment only (.env.production on the server; see README "Deployment") ---
# Port the container listens on and that nginx proxies to. Published on the
# loopback only, so it never needs to be reachable from outside the VPS.
PORT=9010

# ---------------------------------------------------------------------------
# AWS Cognito authentication
# ---------------------------------------------------------------------------
# Pool and client IDs are not secrets (they travel in every Cognito request), which
# is why NEXT_PUBLIC_* is fine. Nothing in the browser reads them — the whole sign-in
# exchange runs in Server Actions and only httpOnly cookies reach the client.
NEXT_PUBLIC_AWS_REGION="us-east-1"
NEXT_PUBLIC_COGNITO_USER_POOL_ID="us-east-1_XXXXXXXXX"
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXX"

# Only needed if the app client was created *with* a client secret. Leave unset for a
# public client; when set, it must never be exposed to the browser (no NEXT_PUBLIC_).
# COGNITO_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# MCP connector (claude.ai ↔ this app) — see README "Claude MCP connector"
# ---------------------------------------------------------------------------
# Public origin as clients see it. Behind nginx the app only sees 127.0.0.1, so the
# OAuth discovery documents need this to build the resource URLs claude.ai validates.
# Dev can leave it unset (falls back to the request's own origin).
APP_URL="https://finance.example.com"

# Second Cognito app client, created for claude.ai (authorization-code + PKCE, redirect
# URI https://claude.ai/api/mcp/auth_callback). Access tokens minted for it are accepted
# alongside the web client's. Leave unset until the client exists.
# COGNITO_MCP_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXX"

# ---------------------------------------------------------------------------
# Bank sync — see planning/features/bank-sync.md
# ---------------------------------------------------------------------------
# No bank provider is wired up yet (Teller shut down in July 2026); the sync engine,
# settings and tests are in place for the next one. These settings are provider-agnostic.

# Encrypts stored bank access tokens at rest (AES-256-GCM). 32 bytes as hex:
#   openssl rand -hex 32
# Changing it orphans every stored token (re-link the banks).
SYNC_TOKEN_ENCRYPTION_KEY=""

# 1 = start the in-process scheduler (production). Leave unset locally so `next dev`
# never polls banks by accident; use `npm run sync -- sync` or Settings → Sync now.
# SYNC_SCHEDULER=1

# Optional bearer for POST /api/sync/run so a host cron can trigger a sync without a
# session (fallback if the in-process scheduler is not wanted).
# SYNC_CRON_SECRET=""
