# Copy to .env.local and fill in the password.
# The database name "personal-billing" contains a hyphen — that's fine inside a URL.
# Append ?ssl-mode=REQUIRED when the server enforces TLS with a self-signed cert
# (MySQL's auto-generated one); use VERIFY_IDENTITY if it has a publicly trusted cert.

# Runtime connection used by the Next.js app (needs SELECT/INSERT/UPDATE/DELETE).
DATABASE_URL="mysql://USER:PASSWORD@DB_HOST:3306/personal-billing"

# Connection used only by drizzle-kit for migrations (needs CREATE/ALTER).
# If your runtime user already has DDL rights, you can omit this and reuse DATABASE_URL.
DATABASE_MIGRATION_URL="mysql://ADMIN:PASSWORD@DB_HOST:3306/personal-billing"

# --- Deployment only (.env.production on the server; see docs/hosting.md) ---
# Port the container listens on and that nginx proxies to. Published on the
# loopback only, so it never needs to be reachable from outside the VPS.
PORT=9010

# ---------------------------------------------------------------------------
# Sign-in — see docs/authentication.md
# ---------------------------------------------------------------------------
# Nothing is needed here. With no Cognito pool configured the app uses built-in accounts:
# the first visit creates yours, and the password hash lives in the database.
#
# AUTH_PROVIDER forces the choice ("local" or "cognito"); the default is cognito when the
# pool variables below are set, otherwise local.
# AUTH_PROVIDER=local

# Built-in auth only. Signs session tokens. Leave unset and one is generated and kept in
# the database; set it (openssl rand -hex 32) to manage it yourself.
# AUTH_SECRET=""

# Session cookies are Secure in production unless APP_URL is http://. Force it either way:
# AUTH_COOKIE_SECURE=0

# --- Optional: AWS Cognito instead of built-in accounts ---
# Pool and client IDs are not secrets (they travel in every Cognito request), which
# is why NEXT_PUBLIC_* is fine. Nothing in the browser reads them — the whole sign-in
# exchange runs in Server Actions and only httpOnly cookies reach the client.
# NEXT_PUBLIC_AWS_REGION="us-east-1"
# NEXT_PUBLIC_COGNITO_USER_POOL_ID="us-east-1_XXXXXXXXX"
# NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXX"

# Only needed if the app client was created *with* a client secret. Leave unset for a
# public client; when set, it must never be exposed to the browser (no NEXT_PUBLIC_).
# COGNITO_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# MCP connector (Claude ↔ this app) — see docs/claude-mcp.md
# ---------------------------------------------------------------------------
# Public origin as clients see it. Behind nginx the app only sees 127.0.0.1, so the
# OAuth discovery documents need this to build the resource URLs claude.ai validates.
# Dev can leave it unset (falls back to the request's own origin).
# APP_URL="https://finance.example.com"

# Cognito only. Second app client, created for claude.ai (authorization-code + PKCE, redirect
# URI https://claude.ai/api/mcp/auth_callback). Access tokens minted for it are accepted
# alongside the web client's. Leave unset until the client exists.
# COGNITO_MCP_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXX"

# ---------------------------------------------------------------------------
# Bank sync — see planning/features/bank-sync.md
# ---------------------------------------------------------------------------
# Provider: SimpleFIN Bridge (bridge.simplefin.org). Linking is done in Settings → Bank Sync
# by pasting a Setup Token; no SimpleFIN keys live in env. These settings are provider-agnostic.

# Encrypts stored bank access tokens at rest (AES-256-GCM). 32 bytes as hex:
#   openssl rand -hex 32
# Changing it orphans every stored token (re-link the banks).
SYNC_TOKEN_ENCRYPTION_KEY=""

# The scheduler starts on its own in production builds (never under `next dev`); turn
# automatic sync on/off in Settings → Bank Sync (default off). Set to 0 only to stop a
# production process from starting the scheduler at all.
# SYNC_SCHEDULER=0

# Optional bearer for POST /api/sync/run so a host cron can trigger a sync without a
# session (fallback if the in-process scheduler is not wanted).
# SYNC_CRON_SECRET=""

# Optional: a SimpleFIN Setup Token to link with (Settings → Bank Sync with the box left
# empty, or `npm run sync -- simplefin link`). Single-use — delete it once linked.
# SIMPLE_FIN_SETUP_TOKEN=""

# 1 = allow SimpleFIN Setup Tokens / Access URLs on hosts other than *.simplefin.org
# (a self-hosted SimpleFIN server). Off by default: claiming makes this server POST to
# wherever a pasted token points.
# SIMPLEFIN_ALLOW_ANY_HOST=1

# Plaid (optional second provider; Settings → Bank Sync → "Link with Plaid").
# The secret is per environment: Sandbox keys only work with PLAID_ENV=sandbox.
# PLAID_API_CLIENT_ID=""
# PLAID_API_SECRET=""
# PLAID_ENV=sandbox                  # sandbox (default) | production
# OAuth banks (Chase, Capital One, BofA, Schwab) send the browser back to
# $APP_URL/settings/sync/plaid-oauth (derived when APP_URL is https). That exact URL must be
# listed under Allowed redirect URIs in the Plaid dashboard. Override only if it differs:
# PLAID_REDIRECT_URI=""
# Where Plaid posts webhooks. Defaults to $APP_URL/api/sync/webhook/plaid when APP_URL is https.
# PLAID_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# AI advisor (Insights + Advisor pages) — see planning/features/ai-advisor.md
# ---------------------------------------------------------------------------
# The app fires a Claude Code routine instead of calling the Anthropic API, so AI work runs
# on your Claude plan. Create the routine on claude.ai with this app's MCP connector and an
# API trigger, then copy the trigger id and the token generated with it. Leave both unset to
# hide the buttons (scheduled routines can still report runs through the connector).
# CLAUDE_ADVISOR_ROUTINE_ID=trig_...
# CLAUDE_ADVISOR_ROUTINE_TOKEN=

# ---------------------------------------------------------------------------
# Demo mode — see docs/demo.md
# ---------------------------------------------------------------------------
# 1 = public demo: sample data, sign-in filled in, real bank linking off.
# It WIPES AND RESEEDS THE DATABASE at every start and every DEMO_RESET_MINUTES.
# Never set it on a database with real data.
# DEMO_MODE=1
# DEMO_RESET_MINUTES=60
